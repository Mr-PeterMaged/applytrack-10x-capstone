* text=auto
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yaml text eol=lf

# Preserve bytes in the explicitly requested local environment snapshot.
**/node_modules/** -text
**/.next/** -text
**/.vercel/** -text
**/.venv/** -text
**/__pycache__/** -text
**/cache/** -text
**/.pytest_cache/** -text
**/.ruff_cache/** -text
**/artifacts/** -text
**/.env -text
**/.env.local -text
**/data/** -text
**/*.db -text
